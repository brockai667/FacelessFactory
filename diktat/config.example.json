{
  "hotkey": "numpad_decimal",
  "mode": "toggle",
  "language": "sk",
  "stt": {
    "backend": "faster-whisper",
    "model": "large-v3-turbo",
    "device": "auto",
    "compute_type": "auto",
    "beam_size": 5,
    "vad_filter": true,
    "initial_prompt": "Diktát pre Claude Code. Python, git, commit, pull request, branch, API, JSON, config, skript, repozitár, funkcia, test, refaktor, deploy.",
    "chunk_seconds": 15,
    "chunk_max_seconds": 30,
    "chunk_silence_rms": 0.008,
    "min_avg_logprob": -1.0,
    "max_no_speech_prob": 0.7,
    "openai_model": "whisper-1",
    "openai_api_key_env": "OPENAI_API_KEY"
  },
  "audio": {
    "sample_rate": 16000,
    "device": null,
    "silence_auto_stop_seconds": 0,
    "max_seconds": 900,
    "beep": true,
    "gate_rms": 0,
    "gate_hangover_seconds": 0.4
  },
  "cleanup": {
    "mode": "light",
    "model": "claude-opus-5",
    "effort": "low",
    "max_tokens": 4000,
    "timeout_seconds": 25,
    "replacements": {
      "git komit": "git commit",
      "komitni": "commitni",
      "pull rekvest": "pull request",
      "pajton": "Python",
      "džejsón": "JSON",
      "džejson": "JSON",
      "readme": "README",
      "klaud kód": "Claude Code",
      "klaud": "Claude"
    }
  },
  "output": {
    "method": "paste",
    "paste_shortcut": "ctrl+v",
    "marker": "🎤 ",
    "markers_recognized": [
      "🎤",
      "[diktát]",
      "[diktat]",
      "[d]"
    ],
    "auto_enter": false,
    "send_keywords": [
      "pošli to",
      "odošli to",
      "to pošli",
      "to odošli",
      "poslať to",
      "odoslať to",
      "pošli",
      "odošli",
      "poslať",
      "odoslať",
      "odoslanie",
      "enter",
      "send"
    ],
    "restore_clipboard": false
  },
  "hook": {
    "llm": false
  },
  "log_dir": "logs",
  "tray": {
    "notify": true,
    "notify_start_stop": true
  },
  "overlay": {
    "enabled": true,
    "alpha": 0.92,
    "font_size": 12
  },
  "follow": {
    "processes": [
      "claude.exe",
      "opera.exe",
      "chrome.exe"
    ],
    "exit_after_seconds": 60
  }
}
