{
  "hotkey": "numpad_decimal",
  "mode": "toggle",
  "language": "sk",
  "stt": {
    "backend": "faster-whisper",
    "model": "large-v3-turbo",
    "device": "auto",
    "compute_type": "auto",
    "beam_size": 5,
    "vad_filter": true,
    "initial_prompt": "Diktát pre Claude Code. Python, git, commit, pull request, branch, API, JSON, config, skript, repozitár, funkcia, test, refaktor, deploy.",
    "openai_model": "whisper-1",
    "openai_api_key_env": "OPENAI_API_KEY"
  },
  "audio": {
    "sample_rate": 16000,
    "device": null,
    "silence_auto_stop_seconds": 0,
    "max_seconds": 900,
    "beep": true
  },
  "cleanup": {
    "mode": "light",
    "model": "claude-opus-5",
    "effort": "low",
    "max_tokens": 4000,
    "timeout_seconds": 25,
    "replacements": {
      "git komit": "git commit",
      "komitni": "commitni",
      "pull rekvest": "pull request",
      "pajton": "Python",
      "džejsón": "JSON",
      "džejson": "JSON",
      "readme": "README",
      "klaud kód": "Claude Code",
      "klaud": "Claude"
    }
  },
  "output": {
    "method": "paste",
    "paste_shortcut": "ctrl+v",
    "marker": "🎤 ",
    "markers_recognized": [
      "🎤",
      "[diktát]",
      "[diktat]",
      "[d]"
    ],
    "auto_enter": false,
    "send_keywords": [
      "pošli to",
      "odošli to",
      "odošli",
      "pošli",
      "enter"
    ],
    "restore_clipboard": false
  },
  "hook": {
    "llm": false
  },
  "log_dir": "logs"
}
