 "facts": [
  {
   "claim": "During prolonged exercise, heart rate and breathing rate rise to deliver more oxygen to muscles.",
   "source": "NIH / American Heart Association"
  },
  {
   "claim": "Stored muscle glycogen can run low around mile 18 to 20, a state runners call 'hitting the wall'.",
   "source": "Mayo Clinic"
  },
  {
   "claim": "Heavy sweating during endurance exercise causes fluid loss and can lead to dehydration if not replaced.",
   "source": "CDC / Mayo Clinic"
  },
  {
   "claim": "Muscle soreness after prolonged exercise is common and usually eases within a few days.",
   "source": "Mayo Clinic"
  }
