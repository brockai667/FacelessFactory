 "facts": [
  {
   "claim": "Do not stand in a doorway: in modern homes doorways are no stronger than the rest of the house. Do not run outside or to another room during shaking.",
   "source": "Earthquake Country Alliance https://www.earthquakecountry.org/dropcoverholdon/"
  },
  {
   "claim": "Most injuries come from falling and flying objects and from people trying to move during the shaking.",
   "source": "McBride et al., USGS-led study (as listed in FACTS-batch-035-046.md; snippet, no number used)"
  },
  {
   "claim": "Drop onto hands and knees, Cover head and neck (under a sturdy table if one is near), Hold on until the shaking stops.",
   "source": "Ready.gov https://www.ready.gov/earthquakes ; Earthquake Country Alliance https://www.earthquakecountry.org/dropcoverholdon/"
  }
 ],
