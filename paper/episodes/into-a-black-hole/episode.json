 },
 "lines": {
  "hook": "You just fell past the edge of our galaxy's black hole.",
  "b1": "Not even light can get back out now.",
  "b2": "Your feet get pulled harder than your head, and you start to stretch.",
  "b3": "Guess how many seconds you have left.",
  "b4": "Twelve point eight. Then the stretch tears you apart like spaghetti.",
  "b5": "Back up. Your friend, watching from far away, sees something else.",
  "b6": "You never quite reach the edge. You slow down, turn red and fade.",
  "b7": "A small black hole rips you apart hundreds of kilometers before its edge.",
  "b8": "The bigger the black hole, the later the stretch.",
  "end": "Watch again and count all twelve point eight seconds."
 },
