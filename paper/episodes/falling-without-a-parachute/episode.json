 },
 "lines": {
  "hook": "You fall out of a plane with no parachute.",
  "b1": "You fall faster every second. Guess your top speed.",
  "b2": "About ten seconds in, the air pushing up matches gravity.",
  "b3": "Belly down, that's about one hundred twenty miles an hour.",
  "b4": "Honest truth. Nobody has ever tested how to survive this.",
  "b5": "Survivor cases point to three things. None is a guarantee.",
  "b6": "One. Land feet first.",
  "b7": "Two. Something soft, like snow or trees.",
  "b8": "Three. A slope, so the stop takes longer.",
  "b9": "Vesna Vulović fell thirty three thousand feet, pinned inside a plane's tail.",
  "end": "The tail hit a snowy slope. She lived. Two out of three."
 },
