 "lines": {
  "hook": "What happens if you stare at screens all day?",
  "b1": "After an hour of screens, you blink far less than normal.",
  "b2": "By four hours, your eyes feel dry, and your vision can blur.",
  "b3": "After six hours, eye strain can bring on a headache.",
  "b4": "By eight hours, your neck and shoulders start to ache.",
  "b5": "By evening, screen light can delay your sleep.",
  "end": "So, when did you last look away from a screen?"
 },
