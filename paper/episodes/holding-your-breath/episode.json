 },
 "lines": {
  "hook": "Why does holding your breath start to burn so fast?",
  "b1": "Sitting on dry land? Hold your breath with me. Ten seconds.",
  "b2": "Feel the pressure in your chest?",
  "b3": "Feels like you're out of oxygen, right?",
  "b4": "You're not. Carbon dioxide is piling up and setting off the alarm.",
  "b5": "Ten. Breathe.",
  "b6": "In one study, untrained people quit after about a minute, still near ninety two percent oxygen.",
  "b7": "One. Keep it short. Ten seconds is plenty.",
  "b8": "Two. Never breathe fast and deep first. It hides the alarm.",
  "b9": "Three. Never do it in water. Blackouts there come without warning.",
  "end": "So that burn you felt? Carbon dioxide, not missing oxygen."
 },
