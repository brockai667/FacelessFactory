 "lines": {
  "hook": "What happens if you never go outside?",
  "b1": "After a day indoors, you miss sunlight, the main signal for your body clock.",
  "b2": "After a week, your skin makes no new vitamin D without sunlight.",
  "b3": "By two weeks, your sleep can start drifting later and later.",
  "b4": "After a month, your vitamin D can drop, and you may feel tired.",
  "b5": "After two months, less daylight can drag your mood down.",
  "end": "So, how much time outside did you get today?"
 },
