 },
 "lines": {
  "hook": "Is there a hole in your vision right now?",
  "b1": "Let's find it, so close your left eye.",
  "b2": "With your right eye, stare at the cross on the left.",
  "b3": "Now slowly bring your phone closer, then back.",
  "b4": "At one spot, the red dot on the right simply vanishes.",
  "b5": "That's your blind spot, where your optic nerve leaves the eye.",
  "b6": "About one point two million nerve fibers exit there, with zero light sensors.",
  "b7": "The gap could hide more than ten full moons.",
  "b8": "You never notice because your brain paints over it with whatever is around.",
  "end": "There's a hole in your vision right now, and your brain hides it."
 },
