 },
 "lines": {
  "hook": "Your car is sinking. Open the window, or wait it out?",
  "b1": "Wait means letting it fill, then pushing the door open.",
  "b2": "But water outside holds the door shut.",
  "b3": "By the time it fills, the car is deep and you have one breath.",
  "b4": "About four hundred people die in sinking cars in North America each year.",
  "b5": "It's the window. You get about a minute before water reaches it.",
  "b6": "One. Seatbelt off.",
  "b7": "Two. Window down, while the power still works.",
  "b8": "Three. Out through it, children first. Don't stop to call.",
  "end": "If you picked wait, you just spent your minute."
 },
