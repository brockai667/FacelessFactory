 },
 "lines": {
  "hook": "You pull a hard turn in a fighter jet.",
  "b1": "At nine G, your head weighs nine times as much.",
  "b2": "The blood drains out of your head. Guess how long you'll be out.",
  "b3": "First the colors fade and the edges go gray.",
  "b4": "Then everything goes black, but you're still awake.",
  "b5": "Then the lights go out. Lock in your guess.",
  "b6": "About twelve seconds out cold. Then roughly fifteen more, confused.",
  "b7": "Back to the start of the turn. Pilots fight back.",
  "b8": "One. Squeeze your legs and stomach hard.",
  "b9": "Two. Breathe in short, forced bursts.",
  "b10": "Three. Your G suit squeezes your legs tight.",
  "end": "Pull the turn again, and this time keep the lights on."
 },
