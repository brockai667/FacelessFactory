 },
 "lines": {
  "hook": "The floor starts shaking. Doorway, or under the table?",
  "b1": "To reach the doorway, you cross the room while it shakes.",
  "b2": "A bookshelf comes down right where you were walking.",
  "b3": "Most injuries come from moving during the shaking, or from falling things.",
  "b4": "And in a modern home, a doorway is no stronger than the rest.",
  "b5": "The table wins. Drop, cover, hold on.",
  "b6": "One. Drop onto your hands and knees.",
  "b7": "Two. Get under a sturdy table and cover your head and neck.",
  "b8": "Three. Hold on until the shaking stops.",
  "end": "Next shake, you're under the table, not in the doorway."
 },
