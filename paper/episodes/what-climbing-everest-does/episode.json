 "lines": {
  "hook": "What happens if you climb Mount Everest?",
  "b1": "At sea level, every breath is full of oxygen.",
  "b2": "By three thousand meters, the air thins, and you breathe faster.",
  "b3": "At five thousand meters, your heart pounds to find more oxygen.",
  "b4": "By seven thousand meters, thin air can bring on a pounding headache.",
  "b5": "At the summit, each breath has only a third of the oxygen.",
  "end": "So, could you handle that thin summit air?"
 },
