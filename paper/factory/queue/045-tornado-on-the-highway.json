  {
   "claim": "Highway overpasses are not shelters: wind speeds are typically higher there and you are a stationary target for flying debris.",
   "source": "NWS Norman https://www.weather.gov/oun/safety-overpass"
  },
  {
   "claim": "On 3 May 1999 in Oklahoma three people were killed under or near overpasses.",
   "source": "NWS Norman https://www.weather.gov/oun/safety-overpass"
  },
  {
   "claim": "Strongest tornado wind ever measured: about 300 mph (NSSL gives 318 mph), by mobile Doppler radar, Bridge Creek-Moore, Oklahoma, 3 May 1999.",
   "source": "NOAA NSSL https://www.nssl.noaa.gov/education/svrwx101/tornadoes/faq/ (OK-number)"
  },
  {
   "claim": "Go to a basement or safe room, else an interior room away from windows; a car is not safe. If caught in a car: stay buckled, head down below the windows, or lie in a spot clearly lower than the road; cover head and neck.",
   "source": "NWS https://www.weather.gov/safety/tornado-during ; https://www.ready.gov/tornadoes"
  }
 ],
