 "facts": [
  {
   "claim": "Swelling follows a venomous bite; remove rings and watches before swelling starts.",
   "source": "CDC/NIOSH Venomous Snakes https://www.cdc.gov/niosh/topics/snakes/symptoms.html"
  },
  {
   "claim": "Do not suck out venom (or cut, tourniquet, ice).",
   "source": "CDC/NIOSH https://www.cdc.gov/niosh/topics/snakes/symptoms.html ; WHO treatment https://www.who.int/teams/control-of-neglected-tropical-diseases/snakebite-envenoming/treatment"
  },
  {
   "claim": "Suction removed about 0.04 % of mock venom in a human model, i.e. less than one percent.",
   "source": "Alberts et al., Ann Emerg Med 2004, PubMed 14747805"
  },
  {
   "claim": "Snakebite kills 81,410 to 137,880 people a year (up to 138,000).",
   "source": "WHO fact sheet https://www.who.int/news-room/fact-sheets/detail/snakebite-envenoming"
  },
  {
   "claim": "Venom mainly spreads through the lymph system, which is why moving spreads it; keep calm and still, immobilize the limb.",
   "source": "WHO treatment page https://www.who.int/teams/control-of-neglected-tropical-diseases/snakebite-envenoming/treatment"
  },
  {
   "claim": "Keep the limb in a neutral position of comfort, immobilized/splinted.",
   "source": "CDC/NIOSH https://www.cdc.gov/niosh/topics/snakes/symptoms.html ; WHO"
  },
  {
   "claim": "Get emergency care; antivenom is the effective treatment; do not drive yourself.",
   "source": "WHO https://www.who.int/teams/control-of-neglected-tropical-diseases/snakebite-envenoming/treatment ; CDC/NIOSH"
  }
 ],
