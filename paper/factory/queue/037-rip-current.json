 "facts": [
  {
   "claim": "A rip current is a strong, narrow flow of water away from shore; it carries you out, it does not pull you under.",
   "source": "NWS https://www.weather.gov/news/211309-7ripcurrent"
  },
  {
   "claim": "Rips can flow up to 8 feet per second, faster than an Olympic swimmer (typical 1 to 2 ft/s).",
   "source": "NWS https://www.weather.gov/safety/ripcurrent-science"
  },
  {
   "claim": "Swimming straight back against a rip exhausts even strong swimmers; rips are linked to an estimated 100+ US drownings a year.",
   "source": "NWS https://www.weather.gov/safety/ripcurrent-science ; Brewster et al., NHESS 2019 https://nhess.copernicus.org/articles/19/389/2019/"
  },
  {
   "claim": "Stay calm, don't fight it, float to save energy, swim parallel to shore until out of it; if you can't, float and wave or yell for help.",
   "source": "NWS https://www.weather.gov/safety/beach-ripcurrents-hazards ; MacMahan / McCarroll 2014 on float-first order"
  }
 ],
