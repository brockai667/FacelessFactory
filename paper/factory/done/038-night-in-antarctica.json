 "facts": [
  {
   "claim": "Alcohol widens blood vessels in the skin: it gives a sensation of warmth but increases heat loss.",
   "source": "CDC MMWR, Hypothermia-Related Deaths 2003 (mm5308a2)"
  },
  {
   "claim": "Larger doses of alcohol can impair shivering; shivering is how the body makes heat.",
   "source": "Kalant & Le 1983, PubMed 6144116 ; Wilderness Medical Society guideline via AAFP https://www.aafp.org/pubs/afp/issues/2020/1101/p571.html"
  },
  {
   "claim": "Shivering stops near 30 C core temperature (= 86 F).",
   "source": "WMS guideline via AAFP https://www.aafp.org/pubs/afp/issues/2020/1101/p571.html"
  },
  {
   "claim": "Insulate from the ground, cover head and neck, stay dry and out of the wind, eat warm high-calorie food.",
   "source": "WMS guideline via AAFP https://www.aafp.org/pubs/afp/issues/2020/1101/p571.html"
  }
 ],
