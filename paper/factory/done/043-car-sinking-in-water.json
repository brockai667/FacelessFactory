 "facts": [
  {
   "claim": "Waiting for the cabin to fill so the pressure equalizes lowers your chance: by then the car is deep and you have one breath. Water outside holds the door shut.",
   "source": "McDonald & Giesbrecht, Aviat Space Environ Med 2013;84:498-510"
  },
  {
   "claim": "About 400 people die in submerged vehicles in North America each year.",
   "source": "McDonald & Giesbrecht, Aviat Space Environ Med 2013;84:498-510 (OK-number)"
  },
  {
   "claim": "A car floats only about 15 to 63 seconds before water reaches the bottom of the side windows (about a minute).",
   "source": "IAED 'Get Out Fast' https://iaedjournal.org/get-out-fast ; McDonald & Giesbrecht 2013"
  },
  {
   "claim": "Protocol: Seatbelts off, Windows open, Out, Children first. Do not phone first.",
   "source": "Dr. Gordon Giesbrecht, University of Manitoba (as listed in FACTS-batch-035-046.md)"
  },
  {
   "claim": "Electric windows should still work if used quickly.",
   "source": "FACTS-batch-035-046.md (043), McDonald & Giesbrecht 2013"
  }
 ],
