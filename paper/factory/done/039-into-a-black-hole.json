 "facts": [
  {
   "claim": "Past the event horizon nothing, not even light, gets back out.",
   "source": "NASA https://science.nasa.gov/universe/black-holes/"
  },
  {
   "claim": "Tidal forces stretch a falling object (spaghettification).",
   "source": "NASA https://science.nasa.gov/universe/what-happens-when-something-gets-too-close-to-a-black-hole/"
  },
  {
   "claim": "At a 4.3-million-Sun black hole like Sagittarius A*, destruction by spaghettification follows 12.8 seconds after crossing the horizon.",
   "source": "NASA Goddard visualization (Schnittman) https://science.nasa.gov/universe/black-holes/supermassive-black-holes/new-nasa-black-hole-visualization-takes-viewers-beyond-the-brink/"
  },
  {
   "claim": "To a distant observer the faller never quite gets there: slows, reddens and fades.",
   "source": "NASA Goddard page (same URL) ; NASA black hole FAQ https://science.nasa.gov/apod/frequently-asked-questions-faqs-on-black-holes"
  },
  {
   "claim": "Small stellar-mass black holes rip objects apart before the horizon, hundreds of kilometers out.",
   "source": "NASA black hole FAQ https://science.nasa.gov/apod/frequently-asked-questions-faqs-on-black-holes"
  }
 ],
