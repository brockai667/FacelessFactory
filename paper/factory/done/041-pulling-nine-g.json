 "facts": [
  {
   "claim": "At nine G everything weighs nine times as much, including your head.",
   "source": "Basic physics, as listed in FACTS-batch-035-046.md (041)"
  },
  {
   "claim": "High positive G pulls blood away from the head and the brain runs short of oxygen.",
   "source": "FAA/CAMI report DOT/FAA/AM-23/6 (Copeland & Whinnery 2023) https://rosap.ntl.bts.gov/view/dot/66373/dot_66373_DS1.pdf"
  },
  {
   "claim": "With slow onset the order is gray-out (loss of colour and side vision), black-out (no vision but still awake), then loss of consciousness (G-LOC).",
   "source": "FAA/CAMI report DOT/FAA/AM-23/6 (Copeland & Whinnery 2023) https://rosap.ntl.bts.gov/view/dot/66373/dot_66373_DS1.pdf"
  },
  {
   "claim": "G-LOC: about 12 seconds fully unconscious, then roughly 15 more seconds confused.",
   "source": "Whinnery & Whinnery 1990, 501 centrifuge episodes (as listed in FACTS-batch-035-046.md, OK-number)"
  },
  {
   "claim": "Pilots fight it with the anti-G straining manoeuvre (tense legs and abdomen, short forced breaths) and a G-suit that squeezes the legs.",
   "source": "FAA/CAMI report DOT/FAA/AM-23/6 https://rosap.ntl.bts.gov/view/dot/66373/dot_66373_DS1.pdf"
  }
 ],
